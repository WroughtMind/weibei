{
  "name": "weibei",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.11"
  },
  "repository": "https://github.com/weibei-app/weibei",
  "scripts": {
    "build:editor": "node Sources/WeiBei/WebEditor/build-editor.mjs",
    "check:editor": "node Sources/WeiBei/WebEditor/build-editor.mjs --check",
    "typecheck:rich-answer": "npm --prefix Prototypes/RichAnswerWebRuntime run typecheck",
    "test:rich-answer": "npm --prefix Prototypes/RichAnswerWebRuntime run test",
    "build:rich-answer": "npm --prefix Prototypes/RichAnswerWebRuntime run build:embed",
    "check:rich-answer": "npm --prefix Prototypes/RichAnswerWebRuntime run check:embedded",
    "check:agent-extension": "node Prototypes/RichAnswerWebRuntime/scripts/check-agent-extension.mjs",
    "check:generated": "npm run check:editor && npm run check:rich-answer",
    "check": "npm run check:editor && npm run check:agent-extension && npm --prefix Prototypes/RichAnswerWebRuntime run check"
  },
  "dependencies": {
    "@milkdown/kit": "7.21.3",
    "@milkdown/plugin-math": "^7.5.9",
    "katex": "^0.17.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^11.16.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "appdmg": "0.6.6",
    "esbuild": "0.28.1"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}

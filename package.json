{
  "name": "weibei",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/weibei-app/weibei",
  "workspaces": [
    "windows"
  ],
  "scripts": {
    "build:editor": "node script/build_editor.mjs",
    "build:windows": "npm run build --workspace @weibei/windows",
    "dev:windows": "npm run dev --workspace @weibei/windows",
    "package:windows": "npm run package --workspace @weibei/windows",
    "test:windows": "npm run test --workspace @weibei/windows",
    "typecheck:windows": "npm run typecheck --workspace @weibei/windows",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json",
    "typecheck:editor": "tsc --noEmit -p tsconfig.editor.json",
    "test:editor": "node --import tsx --test Sources/WeiBei/WebEditor/test/*.test.ts"
  },
  "dependencies": {
    "@milkdown/kit": "7.21.3",
    "@milkdown/plugin-streaming": "7.21.3",
    "katex": "^0.17.0",
    "mermaid": "11.16.1",
    "prismjs": "^1.30.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.1",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  },
  "optionalDependencies": {
    "appdmg": "0.6.6"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}

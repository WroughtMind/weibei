{
  "name": "weibei",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/weibei-app/weibei",
  "workspaces": [
    "Prototypes/RichAnswerWebRuntime"
  ],
  "scripts": {
    "build:editor": "esbuild Sources/WeiBei/WebEditor/src/editor.ts --bundle --format=iife --outfile=Sources/WeiBei/Resources/Editor/editor.js --minify --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --asset-names=fonts/[name]",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json",
    "typecheck:agent": "tsc --noEmit -p tsconfig.agent.json",
    "typecheck:editor": "tsc --noEmit -p tsconfig.editor.json"
  },
  "dependencies": {
    "@milkdown/kit": "7.21.3",
    "@milkdown/plugin-math": "^7.5.9",
    "katex": "^0.17.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "11.16.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^22.10.0",
    "appdmg": "0.6.6",
    "esbuild": "0.28.1",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}

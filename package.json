{
  "name": "weibei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/weibei-app/weibei",
  "workspaces": [
    "Prototypes/RichAnswerWebRuntime"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:editor && npm run verify:generated",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm run typecheck --workspace weibei-rich-answer-web-runtime",
    "test": "vitest run",
    "build:editor": "tsx tooling/build-resources.ts editor",
    "build:website": "tsx tooling/build-resources.ts website",
    "build:oauth": "tsx tooling/build-resources.ts oauth",
    "build:rich-answer": "npm run build:embed --workspace weibei-rich-answer-web-runtime",
    "build:app-resources": "npm run build:editor && npm run build:oauth && npm run build:rich-answer",
    "verify:generated": "tsx tooling/verify-generated.ts",
    "clean:generated": "tsx tooling/clean-generated.ts"
  },
  "dependencies": {
    "@milkdown/kit": "7.21.3",
    "@milkdown/plugin-math": "^7.5.9",
    "katex": "^0.17.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^11.16.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.2",
    "@earendil-works/pi-coding-agent": "0.80.2",
    "@types/node": "22.20.1",
    "@types/prismjs": "1.26.6",
    "appdmg": "0.6.6",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "dompurify": "3.4.12",
    "protobufjs": "7.6.5"
  }
}

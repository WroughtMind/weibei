{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WeiBei Design Tokens",
    "version": "0.1.0",
    "productSource": "Sources/WeiBei/Support/Theme.swift",
    "note": "Product runtime values mirror the current repository. Brand values apply to logo and marketing assets."
  },
  "color": {
    "product": {
      "paper": { "light": "#F4EAD5", "dark": "#0F0F0F" },
      "paperRaised": { "light": "#F9F1DE", "dark": "#151515" },
      "paperInset": { "light": "#E8DBBF", "dark": "#1C1C1C" },
      "ink": { "light": "#1D1814", "dark": "#D7CBB0" },
      "secondaryInk": { "light": "#55493E", "dark": "#9B9178" },
      "tertiaryInk": { "light": "#7D6E5D", "dark": "#6F6655" },
      "cinnabar": { "light": "#91261B", "dark": "#A6362B" },
      "link": { "light": "#305469", "dark": "#C8B98A" },
      "moss": { "light": "#3B624C", "dark": "#B88A42" }
    },
    "brand": {
      "paper": "#F2E2CA",
      "ink": "#231F1C",
      "cinnabar": "#AA2A23",
      "stone": "#4D667A"
    },
    "webEditorCurrentExceptions": {
      "paper": "#F1E4CF",
      "paperRaised": "#F7ECD9",
      "link": "#31566B"
    }
  },
  "space": {
    "2xs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40,
    "5xl": 48,
    "6xl": 64
  },
  "radius": {
    "workspace": 0,
    "control": 4,
    "popover": 8
  },
  "layout": {
    "sidebarMin": 220,
    "sidebarMax": 430,
    "contentReadableMin": 560,
    "contentReadableMax": 780,
    "splitterHitWidth": 10,
    "splitterLineWidth": 1,
    "railDormantWidth": 28,
    "railReadableThreshold": 240,
    "railDefaultExpanded": 420
  },
  "type": {
    "brandLatin": "WeiBeiStele-Regular",
    "brandMono": "WeiBeiSteleMono-Regular",
    "readerBody": { "size": 16, "lineHeight": 27 },
    "notesBody": { "size": 15, "lineHeight": 25 },
    "conversationBody": { "size": 14, "lineHeight": 22 },
    "uiBody": { "size": 13, "lineHeight": 18 },
    "caption": { "size": 11, "lineHeight": 15 }
  },
  "motion": {
    "press": { "kind": "spring", "response": 0.18, "dampingFraction": 0.82 },
    "micro": { "kind": "easeOut", "duration": 0.14 },
    "hover": { "kind": "spring", "response": 0.20, "dampingFraction": 0.86 },
    "reveal": { "kind": "spring", "response": 0.24, "dampingFraction": 0.88 },
    "panel": { "kind": "spring", "response": 0.30, "dampingFraction": 0.88 },
    "layout": { "kind": "spring", "response": 0.38, "dampingFraction": 0.90 },
    "appearance": { "kind": "easeInOut", "duration": 0.42 }
  },
  "logo": {
    "sourceViewBox": "0 0 1254 1254",
    "clearSpaceUnits": 1,
    "clearSpaceReference": "cinnabar square side",
    "texturedMinimumPixels": 128,
    "flatMinimumPixels": 32,
    "smallOpticalMaximumPixels": 64
  }
}

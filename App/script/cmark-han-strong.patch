+// Han text does not require spaces around quoted strong emphasis.
+static bool is_han_character(int32_t c) {
+  return (c >= 0x3400 && c <= 0x4DBF) ||
+         (c >= 0x4E00 && c <= 0x9FFF) ||
+         (c >= 0xF900 && c <= 0xFAFF) ||
+         (c >= 0x20000 && c <= 0x2FA1F) ||
+         (c >= 0x30000 && c <= 0x323AF);
+}

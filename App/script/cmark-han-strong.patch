+// Model output can leave horizontal padding inside a strong span. Resolve
+// these only after ordinary emphasis, so valid nested Markdown keeps priority.
+static bool strong_padding(subject *subj, delimiter *delim, bool opening) {
+  bufsize_t pos = opening ? delim->position : delim->position - delim->length - 1;
+  if (pos < 0 || pos >= subj->input.len) return false;
+  if (!opening) {
+    while (pos > 0 && (subj->input.data[pos] >> 6) == 2) pos--;
+  }
+  int32_t ch = 0;
+  return cmark_utf8proc_iterate(subj->input.data + pos, subj->input.len - pos, &ch) > 0 &&
+         ch != '\n' && ch != '\r' && cmark_utf8proc_is_space(ch);
+}
+
+static bool strong_has_content(subject *subj, delimiter *opener, delimiter *closer) {
+  bufsize_t pos = opener->position;
+  const bufsize_t end = closer->position - closer->length;
+  while (pos < end) {
+    int32_t ch = 0;
+    int size = cmark_utf8proc_iterate(subj->input.data + pos, end - pos, &ch);
+    if (size <= 0 || ch == '\n' || ch == '\r') return false;
+    if (!cmark_utf8proc_is_space(ch)) return true;
+    pos += size;
+  }
+  return false;
+}
+
+static void process_padded_strong(subject *subj, bufsize_t stack_bottom) {
+  delimiter *current = subj->last_delim;
+  delimiter *opener = NULL;
+  if (!current || current->position < stack_bottom) return;
+  while (current->previous && current->previous->position >= stack_bottom)
+    current = current->previous;
+  while (current) {
+    if ((current->delim_char == '*' || current->delim_char == '_') &&
+        current->length == 2 && current->inl_text->as.literal.len == 2) {
+      bool opening_padding = strong_padding(subj, current, true);
+      bool closing_padding = strong_padding(subj, current, false);
+      if (opener && opener->delim_char == current->delim_char &&
+          opener->inl_text->parent == current->inl_text->parent &&
+          opener->inl_text->start_line == current->inl_text->start_line &&
+          (current->can_close || closing_padding) &&
+          (strong_padding(subj, opener, true) || closing_padding) &&
+          strong_has_content(subj, opener, current)) {
+        current = S_insert_emph(subj, opener, current);
+        opener = NULL;
+        continue;
+      }
+      opener = (current->can_open || opening_padding) ? current : NULL;
+    } else {
+      opener = NULL;
+    }
+    current = current->next;
+  }
 }

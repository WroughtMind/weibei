+// Chinese text does not require spaces around emphasis punctuation.
+static bool is_han_character(int32_t c) {
+  return (c >= 0x3400 && c <= 0x4DBF) ||
+         (c >= 0x4E00 && c <= 0x9FFF) ||
+         (c >= 0xF900 && c <= 0xFAFF) ||
+         (c >= 0x20000 && c <= 0x2FA1F) ||
+         (c >= 0x30000 && c <= 0x323AF);
+}
+
+static bool is_cjk_punctuation(int32_t c) {
+  return cmark_utf8proc_is_punctuation(c) &&
+         ((c >= 0x3000 && c <= 0x303F) || (c >= 0xFE10 && c <= 0xFE1F) ||
+          (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFFEF));
+}

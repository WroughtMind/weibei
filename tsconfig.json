{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "script/**/*.ts",
    "DesignSystem/scripts/**/*.ts",
    "Prototypes/RichAnswerWebRuntime/scripts/**/*.ts"
  ]
}

{
  "name": "weibei-rich-answer-web-runtime",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts",
    "self-check": "vitest run --config vitest.config.ts tests/renderers.self-check.test.ts",
    "build": "tsc -b && vite build",
    "build:embed": "npm run build && tsx scripts/embed-runtime.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "serve": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@openuidev/react-lang": "0.2.8",
    "echarts": "6.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4"
  }
}

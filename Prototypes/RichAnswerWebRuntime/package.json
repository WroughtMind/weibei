{
  "name": "weibei-rich-answer-web-runtime",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:legacy": "vite --host 127.0.0.1 --open /legacy.html",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:embed": "npm run build && node scripts/embed-runtime.mjs",
    "check:embedded": "npm run build && node scripts/embed-runtime.mjs --check",
    "check": "npm run typecheck && npm run test && npm run check:embedded",
    "serve": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@openuidev/react-lang": "0.2.8",
    "@vitejs/plugin-react": "4.3.4",
    "echarts": "^5.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "vitest": "^4.1.10"
  }
}

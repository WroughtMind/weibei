# esbuild preserves whitespace inside Mermaid template literals. Treat the
# generated editor bundle as opaque output instead of rewriting those strings.
Sources/WeiBei/Resources/Editor/editor.js whitespace=-trailing-space
Sources/WeiBei/Resources/Editor/*.js text eol=lf
Sources/WeiBei/Resources/Editor/*.css text eol=lf
Sources/WeiBei/Resources/Editor/*.json text eol=lf
Sources/WeiBei/Resources/Editor/*.html text eol=lf

{
  "name": "@weibei/windows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:smoke:typecheck": "tsc --project e2e/tsconfig.json --noEmit",
    "test:smoke:list": "npm run test:smoke:typecheck && playwright test --config playwright.config.ts --list",
    "test:smoke": "npm run test:smoke:typecheck && playwright test --config playwright.config.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "package": "npm run rebuild:native && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "npm run rebuild:native && npm run build && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@milkdown/kit": "7.21.3",
    "@milkdown/plugin-streaming": "7.21.3",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "dompurify": "3.4.12",
    "electron-updater": "6.8.9",
    "katex": "0.17.0",
    "marked": "18.0.11",
    "mermaid": "11.16.1",
    "pdfjs-dist": "6.3.289",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "app.weibei.desktop",
    "productName": "魏碑",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../ASSET_ATTRIBUTIONS.md",
        "to": "ASSET_ATTRIBUTIONS.md"
      }
    ],
    "extraMetadata": {
      "main": "dist/main/index.cjs"
    },
    "win": {
      "icon": "../DesignSystem/assets/app-icon/weibei-app-icon-1024.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "WeiBei-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "魏碑"
    },
    "portable": {
      "artifactName": "WeiBei-${version}-Windows-${arch}-Portable.${ext}"
    }
  }
}
